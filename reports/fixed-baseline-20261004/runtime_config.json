    "signal_gap_policy": "Observed valid completed bars only, no fabricated fills or bars",
    "slope_pct": "100 * (SMA5[t] / SMA5[t-1] - 1)",
    "ordinary_fill": "Next observed tradable session Open strictly after completed signal bar",
    "scheduled_fill": "Calendar-planned last trading day Open of each month; full-day buy ban",
    "valuation": "Observed Open, completed Close and scheduled events in causal order; missing marks retain last-known mark and remain flagged",
    "tax": "20.315% current-calendar-year positive realized after-fee profit; loss realization can refund current-year accrual; no cross-year loss carry",
    "cash_reservation": "Signal-time target plus estimated fee; quantity can shrink at fill but cannot grow",
    "priority": "Sells before buys; buys by descending signal-time SMA5 slope, then ticker, then event ID",
    "gross_fee_views": "Reconcile costs on the same after-tax trade path; not separate reinvestment simulations",
    "rounding": "Whole assumed units; fees/taxes/equity calculated in floating point without additional unapproved currency rounding",
    "full_entry_conjunction": "SMA5/SMA20 bullish cross AND MACD/signal bullish cross in the inclusive N5 window AND ADX14 strictly >25 AND three strictly positive histogram increments over four values ending H>0; distinct cross pair deduplicated. SMA slope ranks competing buys but is not an entry filter."
